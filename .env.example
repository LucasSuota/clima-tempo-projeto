# Copy to .env (cp .env.example .env). Development values, nothing sensitive.

# Database (read by docker-compose.yml)
POSTGRES_USER=climafacil
POSTGRES_PASSWORD=climafacil
POSTGRES_DB=climafacil
# Change it if a local Postgres already uses 5432 (and update the URLs below)
DB_PORT=5432

# Front-end port on the host for `docker compose up` (http://localhost:8080)
WEB_PORT=8080

# Server, local dev (`npm run dev`): the database is on localhost and the front-end runs on Vite (5173).
# Under `docker compose up` the compose file overrides DATABASE_URL (host db), PORT and CORS_ORIGIN
# (http://localhost:$WEB_PORT). The password is inserted into that URL as is, so a password with
# special characters must be URL-encoded.
DATABASE_URL=postgres://climafacil:climafacil@localhost:5432/climafacil
DATABASE_URL_TEST=postgres://climafacil:climafacil@localhost:5432/climafacil_test
PORT=3333
CORS_ORIGIN=http://localhost:5173
# Used in both modes
STALE_DAYS=7
